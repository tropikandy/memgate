#!/usr/bin/env python3
"""warmup: fire one throwaway completion so the first real request after a
cold load does not pay Metal kernel compilation. See IF-7.

Launched by memgate in the background just before exec. Never blocks
serving: a failed warmup means a slower first request, not an outage.
Safely re-entrant -- a model may be started more than once in quick
succession, and two overlapping warmups for the same model are harmless.
"""
import argparse
import sys
import time
import urllib.error
import urllib.request


def poll_health(url, timeout_s, poll_interval_s):
    deadline = time.time() + timeout_s
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=5) as resp:
                if resp.status < 500:
                    return True
        except (urllib.error.URLError, urllib.error.HTTPError):
            pass
        time.sleep(poll_interval_s)
    return False


def fire_completion(url, model, max_tokens, timeout_s):
    import json

    body = json.dumps(
        {
            "model": model,
            "messages": [{"role": "user", "content": "warmup"}],
            "max_tokens": max_tokens,
        }
    ).encode()
    req = urllib.request.Request(url, data=body, method="POST")
    req.add_header("Content-Type", "application/json")
    with urllib.request.urlopen(req, timeout=timeout_s) as resp:
        resp.read()


def main():
    p = argparse.ArgumentParser(prog="warmup")
    p.add_argument("--health-url", required=True, dest="health_url")
    p.add_argument("--completion-url", required=True, dest="completion_url")
    p.add_argument("--model", required=True)
    p.add_argument("--timeout", type=float, default=300)
    p.add_argument("--max-tokens", type=int, default=1, dest="max_tokens")
    p.add_argument("--poll-interval", type=float, default=1, dest="poll_interval")
    args = p.parse_args()

    if not poll_health(args.health_url, args.timeout, args.poll_interval):
        print(f"warmup: health check timed out after {args.timeout}s, skipping", file=sys.stderr)
        return 0  # never treated as an outage

    try:
        fire_completion(args.completion_url, args.model, args.max_tokens, args.timeout)
        print(f"warmup: completed for model {args.model}", file=sys.stderr)
    except (urllib.error.URLError, urllib.error.HTTPError) as exc:
        print(f"warmup: completion failed for model {args.model}: {exc}", file=sys.stderr)

    return 0


if __name__ == "__main__":
    sys.exit(main())
